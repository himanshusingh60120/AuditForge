# ---- AI analysis layer (required for AI explanations; app degrades gracefully without it)
OPENAI_API_KEY=
# Optional: override the model used for issue analysis
OPENAI_MODEL=gpt-4o-mini

# ---- Core Web Vitals (Module B). Get a key: https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# ---- Google Search Console OAuth (v2 roadmap - see README "GSC OAuth" section)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Shareable report links + delta persistence (optional; Vercel KV / Upstash)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- Optional Slack digest webhook (Module M)
SLACK_WEBHOOK_URL=
